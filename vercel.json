{
  "rewrites": [
    { "source": "/api/decision", "destination": "/api/decision" },
    { "source": "/api/arena", "destination": "/api/arena" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
